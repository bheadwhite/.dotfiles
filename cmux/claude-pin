</turn>"""


def digest_path(transcript):
    return DIGESTS / f"{transcript.stem}.json"


_digest_cache = {}


def load_digest(transcript):
    """Parsed digest for a transcript, re-read only when the file changes."""
    path = digest_path(transcript)
    try:
        mtime = path.stat().st_mtime
    except OSError:
        return None
    cached = _digest_cache.get(path)
    if cached and cached[0] == mtime:
        return cached[1]
    try:
        digest = json.loads(path.read_text())
    except (OSError, ValueError):
        return None
    _digest_cache[path] = (mtime, digest)
    return digest


def digest_for(record, prompt_id):
    """The digest a record holds for one turn, or None."""
    record = record or {}
    entry = (record.get("history") or {}).get(prompt_id) or record.get("last") or {}
    if entry.get("prompt_id") == prompt_id:
        return entry.get("digest")
    if record.get("prompt_id") == prompt_id:  # oldest format: the digest at the top level
        return record.get("digest")
    return None


def load_pins():
    try:
        return json.loads(PINS.read_text())
    except (OSError, ValueError):
        return []


def load_settings():
    try:
        return json.loads(SETTINGS.read_text())
    except (OSError, ValueError):
        return {}


def apply_settings():
    global PAD_X, PAD_Y
    PAD_X, PAD_Y = PADDING if load_settings().get("padding", True) else (0, 0)


def set_padding(arg):
    """`claude-pin --padding on|off|toggle`: flip the margin in every running viewer."""
    settings = load_settings()
    on = settings.get("padding", True)
    if arg not in ("on", "off", "toggle", None):
        sys.exit("usage: claude-pin --padding [on|off|toggle]")
    settings["padding"] = not on if arg in ("toggle", None) else arg == "on"
    REGISTRY.mkdir(parents=True, exist_ok=True)
    tmp = SETTINGS.with_suffix(".tmp")
    tmp.write_text(json.dumps(settings))
    tmp.replace(SETTINGS)
    print(f"claude-pin padding {'on' if settings['padding'] else 'off'}")


def save_pins(pins):
    REGISTRY.mkdir(parents=True, exist_ok=True)
    tmp = PINS.with_suffix(".tmp")
    tmp.write_text(json.dumps(pins))
    tmp.replace(PINS)


def toggle_pin(pins, entry):
    """Pin a turn snapshot, or unpin it if it's already pinned. Returns the new list."""
    kept = [p for p in pins if p.get("prompt_id") != entry.get("prompt_id")]
    if len(kept) == len(pins):
        kept.append({**entry, "pinned_at": time.time()})
    save_pins(kept)
    return kept


def dedupe_actions(actions, still_open):
    """Drop repeated items; an item raised this turn wins over its carried-over copy."""
    seen = set()

    def keep(items):
        out = []
        for i in items or []:
            key = " ".join(i.get("text", "").lower().split())
            if key and key not in seen:
                seen.add(key)
                out.append(i)
        return out

    return keep(actions), keep(still_open)


def run_digest(transcript):
    """Digest the latest turn. The file keeps `last` (newest completed digest) and `run`
    (the attempt in flight or its error), so a new run never hides the previous digest."""
    s = Session(transcript)
    s.poll()
    if not s.prompt_id:
        return
    DIGESTS.mkdir(parents=True, exist_ok=True)
    out = digest_path(transcript)
    record = load_digest(transcript) or {}
    last = record.get("last")
    history = dict(record.get("history") or {})  # prompt_id -> digest entry, oldest first
    if last and last.get("prompt_id") not in history:
        history[last.get("prompt_id")] = last

    def save(run, new_last=None):
        if new_last:
            history[new_last["prompt_id"]] = new_last
            for pid in list(history)[:-DIGEST_HISTORY]:
                del history[pid]
        out.write_text(json.dumps({"last": new_last or last, "run": run, "history": history}))

    save({"prompt_id": s.prompt_id, "state": "pending"})
    # Stop fires before the final message lands in the transcript; wait for the turn to close.
    deadline = time.time() + 20
    while s.working and time.time() < deadline:
        time.sleep(0.5)
        s.poll()
    if not s.turn:
        save({"prompt_id": s.prompt_id, "state": "error", "error": "no reply text this turn"})
        return
    if last and last.get("prompt_id") == s.prompt_id:
        earlier = last.get("earlier") or []
    elif last:
        prev = last.get("digest") or {}
        earlier = (prev.get("actions") or []) + (prev.get("still_open") or [])
    else:
        earlier = []
    earlier = earlier[:12]
    turn = "\n\n---\n\n".join(s.turn)[-40000:]
    env = {k: v for k, v in os.environ.items() if not k.startswith("CMUX_")}
    env["CLAUDE_PIN_DIGEST"] = "1"
    cmd = [str(CLAUDE), "-p", "--model", "haiku", "--setting-sources", "project", "--strict-mcp-config",
           "--no-session-persistence", "--tools", "", "--output-format", "json",
           "--json-schema", json.dumps(DIGEST_SCHEMA)]
    focus = ((last or {}).get("digest") or {}).get("focus") or "(none yet)"
    recent = "\n".join(f"- {(t.get('prompt') or '').strip().splitlines()[0][:200]}"
                       for t in s.turns[-5:] if (t.get("prompt") or "").strip()) or "(none)"
    earlier_text = "\n".join(f"- [{i['kind']}] {i['text']}" for i in earlier) or "(none)"
    prompt = DIGEST_PROMPT.replace("{focus}", focus).replace("{recent}", recent) \
        .replace("{earlier}", earlier_text).replace("{prompt}", s.prompt[-8000:]) \
        .replace("{turn}", turn)
    try:
        res = subprocess.run(cmd, input=prompt, capture_output=True, text=True, timeout=120,
                             env=env, cwd=DIGESTS)
        digest = json.loads(res.stdout)["structured_output"]
        digest["actions"], digest["still_open"] = dedupe_actions(digest.get("actions"), digest.get("still_open"))
        save(None, {"prompt_id": s.prompt_id, "prompt": s.prompt[:500], "at": time.time(),
                    "earlier": earlier, "digest": digest})
    except (subprocess.SubprocessError, ValueError, KeyError, TypeError) as e:
        save({"prompt_id": s.prompt_id, "state": "error", "error": str(e)[:200]})


def claude_is_headless():
    """True when the Claude session running this hook is `claude -p` (task workers, scripts)."""
    pid = os.getppid()
    for _ in range(8):
        try:
            out = subprocess.run(["ps", "-o", "ppid=,args=", "-p", str(pid)],
                                 capture_output=True, text=True, timeout=2).stdout.split(None, 1)
        except (OSError, subprocess.SubprocessError):
            return False
        if len(out) < 2:
            return False
        argv = out[1].split()
        if Path(argv[0]).name == "claude":
            return "-p" in argv or "--print" in argv
        pid = int(out[0])
    return False


def log_hook(hook, msg):
    """Append to hook.log (last 200 lines kept) so a hook that does nothing says why."""
    try:
        REGISTRY.mkdir(parents=True, exist_ok=True)
        lines = HOOK_LOG.read_text().splitlines()[-199:] if HOOK_LOG.is_file() else []
        lines.append(f"{datetime.now():%Y-%m-%d %H:%M:%S} {hook} pid={os.getppid()}: {msg}")
        HOOK_LOG.write_text("\n".join(lines) + "\n")
    except OSError:
        pass


def watched_session(hook):
    """Digests and viewers only matter for interactive Claude sessions inside cmux."""
    if os.environ.get("CLAUDE_PIN_DIGEST"):
        return False
    if not os.environ.get("CMUX_WORKSPACE_ID"):
        # cmux's claude wrapper strips every CMUX_* var when its socket ping fails.
        log_hook(hook, "skipped: no CMUX_WORKSPACE_ID (not in cmux, or cmux's wrapper stripped it)")
        return False
    if claude_is_headless():
        log_hook(hook, "skipped: headless claude -p")
        return False
    return True


def session_hook():
    """SessionStart/UserPromptSubmit hook: map this cmux workspace to its transcript."""
    if not watched_session("session"):
        return
    try:
        event = json.load(sys.stdin)
    except ValueError:
        return
    ws, path = os.environ["CMUX_WORKSPACE_ID"], event.get("transcript_path")
    if path:
        REGISTRY.mkdir(parents=True, exist_ok=True)
        (REGISTRY / ws).write_text(path + "\n")


def digest_hook():
    """Stop hook: kick off the digest in the background so the hook returns immediately."""
    if not watched_session("digest"):
        return
    try:
        path = json.load(sys.stdin).get("transcript_path")
    except ValueError:
        return
    if path:
        subprocess.Popen([sys.executable, __file__, "--digest-run", path], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def wrap(text, width, max_lines):
    out = []
    for para in text.splitlines() or [""]:
        out.extend(textwrap.wrap(para, width) or [""])
    if len(out) > max_lines:
        hidden = len(out) - max_lines + 1
        out = out[: max_lines - 1] + [f"{DIM}… +{hidden} more line{'s' if hidden > 1 else ''}{RESET}"]
    return out


INLINE = re.compile(
    r"`([^`]+)`"                                  # code
    r"|\*\*(.+?)\*\*"                               # bold
    r"|(?<![\w*])\*(?![\s*])(.+?)(?<![\s*])\*(?![\w*])"  # italic (not a_b_c identifiers)
    r"|\[([^\]]+)\]\(([^)\s]+)\)"                   # link: keep the text
)


LINK_END = "\033]8;;\033\\"
DEFAULT_GIT_HOST = "git.tcncloud.net"  # for group/project!N refs when the cwd has no remote
REF = re.compile(
    r"(https?://[^\s<>()\[\]`'\"\x00-\x1f]*[^\s<>()\[\]`'\".,;:!?\x00-\x1f])"  # URL, minus trailing punctuation
    r"|(?<![\w/.&!#-])((?:[\w.-]+/)+[\w.-]+)?([!#&])(\d+)\b"   # [group/project]!MR, #issue, group&epic
)
_projects = {}
LINK_PROJECT = None  # (host, project path) of the turn on screen; bare !N / #N resolve against it


def link(url):
    return f"\033]8;;{re.sub(r'[\x00-\x1f]', '', url)}\033\\"


def set_link_project(cwd):
    """Point bare MR/issue refs at the git remote of `cwd` (cached per directory)."""
    global LINK_PROJECT
    if cwd and cwd not in _projects:
        try:
            remote = subprocess.run(["git", "-C", cwd, "remote", "get-url", "origin"],
                                    capture_output=True, text=True, timeout=2).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            remote = ""
        m = re.match(r"(?:\w+://)?(?:[^@/]+@)?([^/:]+)(?::\d+)?[:/](.+?)(?:\.git)?/?$", remote)
        _projects[cwd] = (m.group(1), m.group(2)) if m else None
    LINK_PROJECT = _projects.get(cwd)


def ref_url(path, sigil, num):
    host, project = LINK_PROJECT or (DEFAULT_GIT_HOST, None)
    if sigil == "&":  # epics live on groups, so only link one whose group is named
        return f"https://{host}/groups/{path}/-/epics/{num}" if path else None
    path = path or project
    if not path:
        return None
    if host == "github.com":
        return f"https://{host}/{path}/{'pull' if sigil == '!' else 'issues'}/{num}"
    return f"https://{host}/{path}/-/{'merge_requests' if sigil == '!' else 'issues'}/{num}"


def linkify(plain, styles):
    """Make URLs and GitLab refs in rendered text clickable (OSC 8; cmd+click in cmux)."""
    for m in REF.finditer(plain):
        span = styles[m.start():m.end()]
        if any("\033]8;;" in st for st in span):  # already a markdown link
            continue
        if m.group(1):
            url = m.group(1)
        elif any(CODE in st for st in span):  # `!1` in code is more likely code than a ref
            continue
        else:
            url = ref_url(m.group(2), m.group(3), m.group(4))
        if url:
            styles[m.start():m.end()] = [st + UNDERLINE + link(url) for st in span]
    return styles


def parse_inline(text, base=""):
    """Markdown inline spans -> (plain text, per-character ANSI style)."""
    plain, styles, pos = [], [], 0
    for m in INLINE.finditer(text):
        plain.append(text[pos:m.start()])
        styles += [base] * (m.start() - pos)
        code, bold, italic, label = m.group(1), m.group(2), m.group(3), m.group(4)
        if code is not None:
            plain.append(code)
            styles += [base + CODE] * len(code)
        else:
            inner, style = (bold, BOLD) if bold is not None else (italic, ITALIC) if italic is not None \
                else (label, UNDERLINE + link(m.group(5)))
            p, st = parse_inline(inner, base + style)
            plain.append(p)
            styles += st
        pos = m.end()
    plain.append(text[pos:])
    styles += [base] * (len(text) - pos)
    return "".join(plain), styles


def styled_wrap(text, width, first="", rest="", base=""):
    """Wrap by visible width, keeping inline styles. `first`/`rest` are line prefixes."""
    plain, styles = parse_inline(text, base)
    styles = linkify(plain, styles)
    lines, start, end, prefix = [], None, None, first
    for m in re.finditer(r"\S+", plain):
        ws, we = m.start(), m.end()
        avail = max(1, width - len(visible(prefix)))
        while we - ws > avail and start is None:  # hard-split a word longer than the line
            lines.append((prefix, ws, ws + avail))
            ws, prefix = ws + avail, rest
            avail = max(1, width - len(visible(prefix)))
        if start is not None and we - start > avail:
            lines.append((prefix, start, end))
            start, prefix = None, rest
            avail = max(1, width - len(visible(prefix)))
            while we - ws > avail:
                lines.append((prefix, ws, ws + avail))
                ws = ws + avail
        if start is None:
            start = ws
        end = we
    if start is not None:
        lines.append((prefix, start, end))
    out = []
    for pre, a, b in lines or [(first, 0, 0)]:
        chunks, cur, run = [], None, ""

        def close(st):
            return "" if not st else RESET + LINK_END if "\033]8;;" in st else RESET

        for ch, st in zip(plain[a:b], styles[a:b]):
            if st != cur and run:
                chunks.append((cur or "") + run + close(cur))
                run = ""
            cur, run = st, run + ch
        if run:
            chunks.append((cur or "") + run + close(cur))
        out.append(pre + "".join(chunks))
    return out


ANSI = re.compile(r"\033\[[0-9;]*m|\033\]8;;[^\033]*\033\\")


def visible(s):
    return ANSI.sub("", s)


def markdown(text, width, max_lines):
    """Terminal rendering of the markdown Claude writes: headings, lists, code, quotes, tables."""
    out, in_code, table = [], False, []

    def flush_table():
        if not table:
            return
        rows = [[parse_inline(c.strip())[0] for c in r.strip().strip("|").split("|")] for r in table]
        cols = max(len(r) for r in rows)
        widths = [max((len(r[i]) if i < len(r) else 0) for r in rows) for i in range(cols)]
        for n, r in enumerate(rows):
            cells = [(r[i] if i < len(r) else "").ljust(widths[i]) for i in range(cols)]
            head = BOLD if n == 0 else ""
            line = " │ ".join(cells)[:width].replace("│", f"{DIM}│{RESET}{head}")
            out.append(head + line + RESET)
        table.clear()

    for raw in text.splitlines():
        stripped = raw.strip()
        if stripped.startswith("|") and not in_code:
            if not re.fullmatch(r"[|:\-\s]+", stripped):
                table.append(stripped)
            continue
        flush_table()
        if stripped.startswith("```"):
            in_code = not in_code
            continue
        if in_code:
            out.append(CODE + "  " + raw[: width - 2] + RESET)
        elif not stripped:
            out.append("")
        elif re.fullmatch(r"[-*_]{3,}", stripped):
            out.append(DIM + "─" * min(width, 40) + RESET)
        elif m := re.match(r"#{1,6}\s+(.*)", stripped):
            out += styled_wrap(m.group(1), width, base=BOLD + BLUE)
        elif m := re.match(r"(\s*)([-*+]|\d+[.)])\s+(.*)", raw):
            indent = " " * min(len(m.group(1)), 8)
            marker = "•" if m.group(2) in "-*+" else m.group(2)
            first = f"{indent}{DIM}{marker}{RESET} "
            out += styled_wrap(m.group(3), width, first, indent + " " * (len(marker) + 1))
        elif m := re.match(r">\s?(.*)", stripped):
            out += styled_wrap(m.group(1), width, f"{DIM}│{RESET} ", f"{DIM}│{RESET} ", base=DIM)
        else:
            out += styled_wrap(stripped, width)
    flush_table()
    if len(out) > max_lines:
        hidden = len(out) - max_lines + 1
        out = out[: max_lines - 1] + [f"{DIM}… +{hidden} more line{'s' if hidden > 1 else ''}{RESET}"]
    return out


def ago(secs):
    secs = max(0, int(secs))
    return f"{secs}s" if secs < 60 else f"{secs // 60}m{secs % 60:02d}s" if secs < 3600 else f"{secs // 3600}h{secs % 3600 // 60:02d}m"


ACTION_MARK = {"answer": (ORANGE, "?"), "do": (ORANGE, "→"), "verify": (BLUE, "✓"), "optional": (DIM, "◦")}


def action_lines(items, width):
    lines = []
    for a in items:
        color, mark = ACTION_MARK.get(a.get("kind"), (RESET, "•"))
        lines += styled_wrap(a.get("text", ""), width, f"{color}{mark}{RESET} ", "  ")
    return lines


def digest_lines(d, show_details, width):
    lines = styled_wrap(d.get("headline", ""), width, base=BOLD)
    actions = d.get("actions") or []
    lines.append(f"{BOLD}{ORANGE}NEXT STEPS{RESET}")
    if not actions:
        lines.append(DIM + "Nothing needs you." + RESET)
    lines += action_lines(actions, width)
    still_open = d.get("still_open") or []
    if still_open:
        lines.append(f"{BOLD}{ORANGE}STILL OPEN{RESET}  {DIM}from earlier turns{RESET}")
        lines += action_lines(still_open, width)
    lines.append(f"{BOLD}{MINT}SUMMARY{RESET}")
    for b in d.get("summary") or []:
        lines += styled_wrap(b, width, "• ", "  ")

    details = d.get("details") or []
    if show_details:
        for group in details:
            lines.append(f"{BOLD}{group.get('topic', '')}{RESET}")
            for p in group.get("points") or []:
                lines += styled_wrap(p, width, f"  {DIM}-{RESET} ", "    ")
        lines.append(DIM + "[d] hide details" + RESET)
    elif details:
        topics = ", ".join(g.get("topic", "") for g in details)
        lines += [DIM + l + RESET for l in wrap(f"[d] details: {topics}", width, 2)]
    return lines


def content_width():
    """Columns available to text once the side padding is taken out."""
    return max(20, shutil.get_terminal_size().columns - 2 * PAD_X)


def render(s, record=None, show_details=False):
    """Every line of the view, untrimmed, and the index of the newest section's first line."""
    width = content_width()
    record = record or {}
    last = record.get("last") or ({"prompt_id": record.get("prompt_id"), "digest": record["digest"]}
                                  if "digest" in record else None)
    run = record.get("run") if (record.get("run") or {}).get("prompt_id") == s.prompt_id else None

    if s.working:
        status = f"{ORANGE}● working{RESET}"
        if s.prompt_at:
            status += f"  {DIM}{ago(time.time() - s.prompt_at)} since prompt{RESET}"
    else:
        status = f"{MINT}● done{RESET}"
        if s.ended_at:
            status += f"  {DIM}{ago(time.time() - s.ended_at)} ago{RESET}"

    # Oldest at the top, newest at the bottom: the digest goes below the prompt and update
    # once it's newer than both (it summarizes this finished turn), above them otherwise.
    note = ""
    if run and run.get("state") == "pending":
        note = " · summarizing…"
    elif run and run.get("state") == "error":
        note = f" · summary failed: {run.get('error', '')}"
    digest = []
    if last:
        if last.get("prompt_id") == s.prompt_id:
            label = "DIGEST · this turn"
        else:
            first = (last.get("prompt") or "").splitlines()[0] if last.get("prompt") else ""
            label = f"DIGEST · previous turn{': ' + first if first else ''}"
        digest = [DIM + ("── " + label + note + " ")[:width].ljust(width, "─") + RESET]
        digest += digest_lines(last["digest"], show_details, width)
    elif note:
        digest = [DIM + ("── DIGEST" + note + " ")[:width].ljust(width, "─") + RESET]
    newest_turn = max(t for t in (s.prompt_at, s.update_at, 0) if t is not None)
    if last and last.get("at"):
        digest_last = last["at"] >= newest_turn
    else:  # older digests carry no timestamp
        digest_last = bool(last) and last.get("prompt_id") == s.prompt_id and not s.working

    prompt = [f"{BOLD}{BLUE}PROMPT{RESET}  {status}"]
    prompt += wrap(s.prompt or "(no prompt yet)", width, PROMPT_LINES)
    prompt += [f"{DIM}+ {q.splitlines()[0][: width - 2]}{RESET}" for q in s.queued[-3:]]
    live = [""]
    if s.tool and s.working:
        live += [f"{ORANGE}▶ {s.tool[: width - 2]}{RESET}", ""]
    live.append(f"{BOLD}{MINT}LATEST UPDATE{RESET}")
    gap = [""] if digest else []
    turn = prompt + live + markdown(s.update or "(nothing yet)", width, sys.maxsize)
    if digest_last:
        return turn + gap + digest, (len(turn) + len(gap) if digest else 0)
    return digest + gap + turn, len(digest) + len(gap)


def when(ts):
    if not ts:
        return ""
    t = datetime.fromtimestamp(ts)
    return f"{t:%H:%M}" if t.date() == datetime.now().date() else f"{t:%b} {t.day} {t:%H:%M}"


def past_render(entry, digest, show_details, meta=""):
    """A finished turn (from history or the pinned list): prompt, final update, digest."""
    width = content_width()
    lines = [f"{BOLD}{BLUE}PROMPT{RESET}  {DIM}{meta}{RESET}"]
    lines += wrap(entry.get("prompt") or "(no prompt)", width, PROMPT_LINES)
    lines += ["", f"{BOLD}{MINT}LATEST UPDATE{RESET}"]
    lines += markdown(entry.get("update") or "(no reply)", width, sys.maxsize)
    if digest:
        lines += ["", DIM + "── DIGEST "[:width].ljust(width, "─") + RESET]
        lines += digest_lines(digest, show_details, width)
    return lines


def header_line(width, view, position, pinned):
    """Sticky top line: which list is showing, where you are in it, and the paging keys."""
    def tab(name, on):
        return f"{BOLD}{BLUE}{name}{RESET}" if on else f"{DIM}{name}{RESET}"
    left = f"{tab('SESSION', view == 'session')} {tab('PINNED', view == 'pinned')}  {DIM}{position}{RESET}"
    if pinned:
        left += f"  {ORANGE}★ pinned{RESET}"
    hints = f"[ ] turn · p {'unpin' if view == 'pinned' else 'pin'} · h/l list"
    pad = width - len(visible(left)) - len(hints)
    return left + " " * pad + DIM + hints + RESET if pad >= 2 else left


def context_lines(session, record, width):
    """Sticky lines under the header: what the session is working on, then its directory."""
    cwd = session.cwd or ""
    home = str(Path.home())
    cwd = "~" + cwd[len(home):] if cwd == home or cwd.startswith(home + "/") else cwd
    if len(cwd) > width:
        cwd = "…" + cwd[len(cwd) - width + 1:]
    focus = (((record or {}).get("last") or {}).get("digest") or {}).get("focus") or ""
    lines = []
    if focus:
        wrapped = styled_wrap(focus, width - 1, base=BOLD)  # styled so refs in it stay clickable
        lines.append(wrapped[0] + ("…" if len(wrapped) > 1 else ""))
    if cwd:
        lines.append(f"{DIM}{cwd}{RESET}")
    return lines


def viewport(head, lines, top, rows, width):
    """The frame: the `head` lines pinned to the top, then as many lines of `lines` from `top`
    (returned clamped) as fit. Content that overflows gets a position bar on the last line."""
    head = [head] if isinstance(head, str) else head
    rows -= len(head) + 2 * PAD_Y
    if len(lines) <= rows:
        return draw(head + lines), 0
    height = rows - 1
    top = max(0, min(top, len(lines) - height))
    above, below = ("▲" if top else " "), ("▼" if top + height < len(lines) else " ")
    bar = f"── {above}{below} {top + 1}-{top + height} of {len(lines)} · j/k scroll · space/b page · g/G ends "
    bar = DIM + bar[:width].ljust(width, "─") + RESET
    return draw(head + lines[top:top + height] + [bar]), top


def draw(lines):
    """Clear the screen and draw `lines` inside the PAD_X/PAD_Y margin."""
    return "\033[H\033[2J" + "\n" * PAD_Y + "\n".join(" " * PAD_X + l for l in lines)


KEY_SEQ = re.compile(r"\033\[[0-9;]*[A-Za-z~]|\033O[A-Za-z]|.", re.DOTALL)
ESCAPES = {"\033[A": "up", "\033OA": "up", "\033[B": "down", "\033OB": "down",
           "\033[D": "left", "\033OD": "left", "\033[C": "right", "\033OC": "right",
           "\033[5~": "pgup", "\033[6~": "pgdn", "\033[H": "home", "\033OH": "home",
           "\033[1~": "home", "\033[F": "end", "\033OF": "end", "\033[4~": "end"}


def read_keys(timeout):
    """Keys pressed within `timeout`; arrows and paging keys come back as names. A wheel
    tick arrives as a burst of arrows (alternate-scroll mode), so return them all."""
    if not sys.stdin.isatty():
        time.sleep(timeout)
        return []
    ready, _, _ = select.select([sys.stdin], [], [], timeout)
    if not ready:
        return []
    data = os.read(sys.stdin.fileno(), 1024).decode(errors="ignore")
    return [ESCAPES.get(k, k) for k in KEY_SEQ.findall(data)]


def main():
    if sys.argv[1:2] == ["--hook"]:
        return session_hook()
    if sys.argv[1:2] == ["--digest"]:
        return digest_hook()
    if sys.argv[1:2] == ["--digest-run"]:
        return run_digest(Path(sys.argv[2]))
    if sys.argv[1:2] == ["--padding"]:
        return set_padding(sys.argv[2] if len(sys.argv) > 2 else None)
    script = Path(__file__).resolve()
    built = script.stat().st_mtime
    path = None
    session = None
    last = None
    show_details = False
    top, follow, seen_prompt = 0, True, None
    # view is "session" (this session's turns) or "pinned"; turn is an index into
    # session.turns, or None for the live turn; pin indexes the pinned list.
    view, turn, pin = "session", None, None
    ws, surface = os.environ.get("CMUX_WORKSPACE_ID"), os.environ.get("CMUX_SURFACE_ID")
    if ws and surface:
        VIEWERS.mkdir(parents=True, exist_ok=True)
        (VIEWERS / ws).write_text(f"{surface} {os.getpid()}\n")
    saved = termios.tcgetattr(sys.stdin) if sys.stdin.isatty() else None
    if saved:
        tty.setcbreak(sys.stdin)
    # Alternate screen, cursor hidden; mode 1007 turns the mouse wheel into arrow keys there.
    sys.stdout.write("\033[?1049h\033[?1007h\033[?25l")
    try:
        while True:
            current = resolve_transcript()
            if current and current != path:
                path, session, turn = current, Session(current), None
            if session:
                try:
                    session.poll()
                except FileNotFoundError:
                    path = session = turn = None
            if script.stat().st_mtime != built:  # edited: restart on the new code
                if saved:
                    termios.tcsetattr(sys.stdin, termios.TCSADRAIN, saved)
                sys.stdout.write("\033[?25h\033[?1049l")
                sys.stdout.flush()
                os.execv(sys.executable, [sys.executable, str(script)] + sys.argv[1:])
            apply_settings()
            size = shutil.get_terminal_size()
            width = content_width()
            pins = load_pins()
            pinned_ids = {p.get("prompt_id") for p in pins}
            record = load_digest(path) if path else None
            shown = None  # the turn on screen, as a snapshot `p` can pin
            if view == "pinned":
                pin = None if not pins else len(pins) - 1 if pin is None else max(0, min(pin, len(pins) - 1))
                if pin is None:
                    head = header_line(width, view, "empty", False)
                    lines, anchor = ["", DIM + "Nothing pinned yet. Press p on a turn to pin it." + RESET], 0
                else:
                    shown = pins[pin]
                    set_link_project(shown.get("cwd"))
                    if not shown.get("digest"):  # pinned before its digest landed
                        digest = digest_for(load_digest(Path(f"{shown.get('session')}.jsonl")), shown["prompt_id"])
                        if digest:
                            shown["digest"] = digest
                            save_pins(pins)
                    meta = " · ".join(x for x in (Path(shown.get("cwd") or "").name, when(shown.get("prompt_at"))) if x)
                    head = header_line(width, view, f"{pin + 1}/{len(pins)}", True)
                    lines, anchor = past_render(shown, shown.get("digest"), show_details, meta), 0
            elif session:
                set_link_project(session.cwd)
                context = context_lines(session, record, width)
                if turn is not None and turn >= len(session.turns):
                    turn = None
                if turn is None and session.prompt_id != seen_prompt:
                    seen_prompt, follow = session.prompt_id, True
                total = len(session.turns) + 1
                if turn is None:
                    shown = session.snapshot() if session.prompt_id else None
                    head = header_line(width, view, f"turn {total}/{total} · live", session.prompt_id in pinned_ids)
                    lines, anchor = render(session, record, show_details)
                    head = [head] + context
                else:
                    shown = session.turns[turn]
                    head = header_line(width, view, f"turn {turn + 1}/{total}", shown["prompt_id"] in pinned_ids)
                    digest = digest_for(record, shown["prompt_id"])
                    lines, anchor = past_render(shown, digest, show_details, when(shown.get("prompt_at"))), 0
                    head = [head] + context
            if view == "pinned" or session:
                frame, top = viewport(head, lines, anchor if follow else top, size.lines, width)
            else:
                frame = draw(["Waiting for a Claude session in this workspace…"])
            if (frame, size) != last:
                sys.stdout.write(frame)
                sys.stdout.flush()
                last = (frame, size)
            page = max(1, size.lines - 3 - 2 * PAD_Y)
            for key in read_keys(1):
                if key == "q":
                    return
                if key == "d":
                    show_details, last = not show_details, None
                elif key in ("h", "l"):  # two lists, so either key flips to the other
                    view = "pinned" if view == "session" else "session"
                    top, follow = 0, view == "session" and turn is None
                elif key in ("[", "]", "left", "right"):
                    back = key in ("[", "left")
                    if view == "pinned" and pin is not None:
                        pin += -1 if back else 1
                    elif view == "session" and session:
                        if back:
                            turn = max(0, turn - 1) if turn is not None else len(session.turns) - 1 if session.turns else None
                        elif turn is not None:
                            turn = turn + 1 if turn + 1 < len(session.turns) else None
                        top, follow = 0, turn is None
                elif key == "p" and shown and shown.get("prompt_id"):
                    if view == "session":
                        shown["digest"] = digest_for(record, shown["prompt_id"])
                    toggle_pin(pins, shown)
                    last = None
                step = {"j": 1, "down": 1, "k": -1, "up": -1, " ": page, "pgdn": page, "f": page,
                        "b": -page, "pgup": -page, "g": -sys.maxsize, "home": -sys.maxsize,
                        "G": sys.maxsize, "end": sys.maxsize}.get(key)
                if step:
                    top, follow = top + step, False  # viewport() clamps it
    except KeyboardInterrupt:
        pass
    finally:
        if saved:
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, saved)
        sys.stdout.write("\033[?25h\033[?1049l")
        sys.stdout.flush()


if __name__ == "__main__":
    main()
