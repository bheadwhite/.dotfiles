#!/bin/sh
# Claude Code SessionStart/UserPromptSubmit hook: record which transcript this cmux
# workspace's Claude session is writing, so claude-pin can follow it.
[ -n "$CMUX_WORKSPACE_ID" ] || exit 0
[ -n "$CLAUDE_PIN_DIGEST" ] && exit 0
path=$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("transcript_path",""))' 2>/dev/null)
[ -n "$path" ] || exit 0
mkdir -p "$HOME/.cache/claude-pin" && printf '%s\n' "$path" > "$HOME/.cache/claude-pin/$CMUX_WORKSPACE_ID"
exit 0
