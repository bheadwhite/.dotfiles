#!/usr/bin/env python3
"""Register cmux-gitlab's hooks in ~/.claude/settings.json (idempotent).

The hooks run `cmux-gitlab hook` async, so a prompt or a finished turn in any Claude session
refreshes every workspace's GitLab pills (throttled to once a minute) without blocking.
Also symlinks cmux-gitlab into ~/.local/bin and writes the /gitlab-epic slash command.
Existing cmux-gitlab entries are replaced, the previous settings are kept as settings.json.bak.
--uninstall removes all of it instead.
"""
import json
import shutil
import sys
from pathlib import Path

SETTINGS = Path.home() / ".claude" / "settings.json"
HERE = Path(__file__).resolve().parent
LINK = Path.home() / ".local" / "bin" / "cmux-gitlab"
COMMAND = Path.home() / ".claude" / "commands" / "gitlab-epic.md"
COMMAND_BODY = f"""---
description: Mark this cmux workspace as an epic session (&N, group&N, URL, or --clear)
argument-hint: <&N | group&N | epic URL | --clear>
allowed-tools: Bash({HERE}/cmux-gitlab:*)
---
!`{HERE}/cmux-gitlab epic $ARGUMENTS`

Reply with just the line above, nothing else.
"""
HOOK = {"type": "command", "command": f"{HERE}/cmux-gitlab hook", "async": True, "timeout": 60}
EVENTS = {"SessionStart": {"matcher": ""}, "UserPromptSubmit": {}, "Stop": {}}


def is_ours(group):
    return any("cmux-gitlab" in h.get("command", "") for h in group.get("hooks", []))


def main():
    uninstall = sys.argv[1:] == ["--uninstall"]
    settings = json.loads(SETTINGS.read_text()) if SETTINGS.is_file() else {}
    hooks = settings.setdefault("hooks", {})
    for event, extra in EVENTS.items():
        groups = [g for g in hooks.get(event, []) if not is_ours(g)]
        if not uninstall:
            groups.append({**extra, "hooks": [HOOK]})
        if groups:
            hooks[event] = groups
        else:
            hooks.pop(event, None)
    if SETTINGS.is_file():
        shutil.copy2(SETTINGS, SETTINGS.with_suffix(".json.bak"))
    SETTINGS.write_text(json.dumps(settings, indent=2) + "\n")

    if uninstall:
        LINK.unlink(missing_ok=True)
        COMMAND.unlink(missing_ok=True)
        print("cmux-gitlab hooks, symlink and /gitlab-epic removed")
        return
    LINK.parent.mkdir(parents=True, exist_ok=True)
    LINK.unlink(missing_ok=True)
    LINK.symlink_to(HERE / "cmux-gitlab")
    COMMAND.parent.mkdir(parents=True, exist_ok=True)
    COMMAND.write_text(COMMAND_BODY)
    print(f"cmux-gitlab hooks registered in {SETTINGS}; {LINK} and /gitlab-epic written")


if __name__ == "__main__":
    main()
